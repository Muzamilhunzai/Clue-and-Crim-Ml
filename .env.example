# Copy this file to ".env" in the project root (same folder as package.json).
# On Windows PowerShell:  Copy-Item .env.example .env

# --- Server -----------------------------------------------------------
NODE_ENV=development
PORT=4000

# SQLite database file (relative paths are resolved from the project root)
DATABASE_PATH=database/data/tracenet.db

# Session lifetime in hours (absolute). The cookie is HttpOnly + SameSite=Lax.
SESSION_TTL_HOURS=12

# Set to true only when the app is served over HTTPS (adds the Secure cookie flag).
COOKIE_SECURE=false

# Extra browser origin allowed to call the API with credentials (the Vite dev server
# already works through its proxy, so this is normally not needed).
CLIENT_ORIGIN=http://localhost:5173

# --- Demo / seed data -------------------------------------------------
# DEMO ONLY. The seed script hashes this password for every seeded fictional account.
# Never reuse it anywhere else. Change it before seeding if you like.
DEMO_PASSWORD=TraceNet@2026

# When true, the login screen offers one-click demo accounts (it reveals the demo password).
# The server refuses to start with DEMO_MODE=true when NODE_ENV=production.
DEMO_MODE=true
